# Base URL of the Laravel API (no trailing slash).
# Used by src/lib/api/client.ts for every backend request,
# incl. GET {NEXT_PUBLIC_API_URL}/v1/settings (storefront settings)
# and GET {NEXT_PUBLIC_API_URL}/v1/catalog/... (categories/products).
# Docker (Sail): http://localhost:8000/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# Public URL of this Next.js storefront (metadata, sitemap, sharing).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
