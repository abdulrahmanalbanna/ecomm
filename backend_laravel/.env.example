APP_NAME="Commerce Single Vendor"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =============================================================================
# DATABASE — PostgreSQL (Docker Sail)
# =============================================================================
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=ecommerce
DB_USERNAME=sail
DB_PASSWORD=your-strong-password-here
DB_SCHEMA=public
DB_SSLMODE=prefer
FORWARD_DB_PORT=5433

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

QUEUE_CONNECTION=sync
CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# =============================================================================
# REDIS — Docker Sail
# =============================================================================
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@commerce.local"
MAIL_FROM_NAME="${APP_NAME}"

# =============================================================================
# PAYMENTS — Tabby / Tamara (Task 10)
# SECRETS ONLY VIA ENV. Never store these in payment_gateways.config or SQL.
# Tests use fake values; leave blank locally to keep the app fully testable
# offline (gateway HTTP calls are mocked with Http::fake()).
# =============================================================================
PAYMENTS_CURRENCY=SAR

TABBY_API_KEY=
TABBY_API_SECRET=
TABBY_WEBHOOK_SECRET=
TABBY_BASE_URL=https://api.tabby.ai/api/v2
TABBY_MERCHANT_CODE=TEST-CommerceSingleVendor

TAMARA_API_KEY=
TAMARA_API_SECRET=
TAMARA_WEBHOOK_SECRET=
TAMARA_BASE_URL=https://api.tamara.co
TAMARA_MERCHANT_CODE=commerce-single-vendor

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
